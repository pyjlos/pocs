name: "question_answering"
backend: "python"
max_batch_size: 8

input [
  {
    name: "QUESTION"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "CONTEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "ANSWER"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "SCORE"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
  }
]
